# make        generate mermin-equations.sty and typeset the manual mermin-equations.pdf
# make test   run the test suite (ENGINE=pdflatex|lualatex|xelatex)
# make ctan   build mermin-equations.zip for upload to CTAN
# make clean  remove generated and auxiliary files

ENGINE ?= pdflatex

all: mermin-equations.sty mermin-equations.pdf

mermin-equations.sty: mermin-equations.ins mermin-equations.dtx
	tex -interaction=nonstopmode mermin-equations.ins >/dev/null

# A TeX run caught in a loop can write an endless .aux or .log; cap each
# process at about 100 MB of file and 300 s of CPU so it fails instead.
# (dash's ulimit takes one limit per call.)
CAPPED = ulimit -f 200000; ulimit -t 300;

mermin-equations.pdf: mermin-equations.dtx mermin-equations.sty
	$(CAPPED) pdflatex -interaction=nonstopmode -halt-on-error mermin-equations.dtx >/dev/null
	makeindex -q -s gind.ist mermin-equations.idx
	! grep -q '[1-9][0-9]* rejected' mermin-equations.ilg || { cat mermin-equations.ilg; exit 1; }
	makeindex -q -s gglo.ist -o mermin-equations.gls mermin-equations.glo
	$(CAPPED) pdflatex -interaction=nonstopmode -halt-on-error mermin-equations.dtx >/dev/null
	$(CAPPED) pdflatex -interaction=nonstopmode -halt-on-error mermin-equations.dtx >/dev/null

test: mermin-equations.sty
	$(MAKE) -C test ENGINE=$(ENGINE)

# CTAN wants the sources, the typeset manual, and the README in one
# top-level directory named for the package; mermin-equations.sty is generated by the
# installer, so it is left out.
CTAN_FILES = mermin-equations.dtx mermin-equations.ins mermin-equations.pdf README.md
ctan: $(CTAN_FILES)
	rm -rf ctan-build mermin-equations.zip
	mkdir -p ctan-build/mermin-equations
	cp $(CTAN_FILES) ctan-build/mermin-equations/
	chmod 755 ctan-build/mermin-equations
	chmod 644 ctan-build/mermin-equations/*
	cd ctan-build && zip -qrX ../mermin-equations.zip mermin-equations
	rm -rf ctan-build
	@unzip -l mermin-equations.zip

clean:
	rm -f $(addprefix mermin-equations.,zip sty pdf aux log out toc idx ind ilg glo gls hd)
	$(MAKE) -C test clean

.PHONY: all test ctan clean
