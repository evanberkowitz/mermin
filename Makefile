# make        generate mermin.sty and typeset the manual mermin.pdf
# make test   run the test suite (ENGINE=pdflatex|lualatex|xelatex)
# make ctan   build mermin.zip for upload to CTAN
# make clean  remove generated and auxiliary files

ENGINE ?= pdflatex

all: mermin.sty mermin.pdf

mermin.sty: mermin.ins mermin.dtx
	tex -interaction=nonstopmode mermin.ins >/dev/null

# A TeX run caught in a loop can write an endless .aux or .log; cap each
# process at about 100 MB of file and 300 s of CPU so it fails instead.
# (dash's ulimit takes one limit per call.)
CAPPED = ulimit -f 200000; ulimit -t 300;

mermin.pdf: mermin.dtx mermin.sty
	$(CAPPED) pdflatex -interaction=nonstopmode -halt-on-error mermin.dtx >/dev/null
	makeindex -q -s gind.ist mermin.idx
	! grep -q '[1-9][0-9]* rejected' mermin.ilg || { cat mermin.ilg; exit 1; }
	makeindex -q -s gglo.ist -o mermin.gls mermin.glo
	$(CAPPED) pdflatex -interaction=nonstopmode -halt-on-error mermin.dtx >/dev/null
	$(CAPPED) pdflatex -interaction=nonstopmode -halt-on-error mermin.dtx >/dev/null

test: mermin.sty
	$(MAKE) -C test ENGINE=$(ENGINE)

# CTAN wants the sources, the typeset manual, and the README in one
# top-level directory named for the package; mermin.sty is generated by the
# installer, so it is left out.
CTAN_FILES = mermin.dtx mermin.ins mermin.pdf README.md
ctan: $(CTAN_FILES)
	rm -rf ctan-build mermin.zip
	mkdir -p ctan-build/mermin
	cp $(CTAN_FILES) ctan-build/mermin/
	chmod 755 ctan-build/mermin
	chmod 644 ctan-build/mermin/*
	cd ctan-build && zip -qrX ../mermin.zip mermin
	rm -rf ctan-build
	@unzip -l mermin.zip

clean:
	rm -f mermin.zip mermin.sty mermin.pdf mermin.aux mermin.log mermin.out mermin.toc \
	      mermin.idx mermin.ind mermin.ilg mermin.glo mermin.gls mermin.hd
	$(MAKE) -C test clean

.PHONY: all test ctan clean
