%% mermin.sty
%%
%% Tools for writing equations the way N. David Mermin asks in
%% "What's Wrong with These Equations?" (Physics Today, October 1989).
%%
%% \alsolabel{key}
%%   Attach an additional label to the current equation or align line.
%%   amsmath allows only one \label per numbered display line; \alsolabel
%%   may be used any number of times alongside (before or after) at most
%%   one \label, or on its own.  Every key refers to the same number and
%%   the same hyperref anchor, so one equation can be cited under several
%%   names, each matching the noun phrase used at that point in the prose:
%%
%%     \begin{equation}
%%       Q_L^2 = Q_R^2
%%       \label{eq:anomaly}
%%       \alsolabel{eq:3450 condition}
%%     \end{equation}
%%     ... the anomaly condition~\eqref{eq:anomaly} ...
%%     ... the 3450 condition~\eqref{eq:3450 condition} ...
%%
%%   Outside amsmath displays \alsolabel is just \label.
%%
%% \label itself is not modified: two \label's on one line are still an
%% error.  Compatible with hyperref, cleveref (\cref works on every key) and
%% empheq, loaded in any order.  Needs LaTeX 2020-10-01 or later.
\NeedsTeXFormat{LaTeX2e}[2020/10/01]
\ProvidesPackage{mermin}[2026/11/16 v0.1 Mermin-style equation tools]
\RequirePackage{amsmath}

% How it works.  amsmath keeps a display line's label in \df@label (in the
% form \label@in@display stored it; cleveref wraps the key in braces) and
% writes it with \ltx@label{<\df@label>} once the tag is known.  Extra keys
% wait in \mermin@queue, as \do{<stored form>}, tagged with the \df@label of
% the line they belong to (\mermin@tag).  They are written right after that
% primary label, so they get the same number and hyperref anchor.  The tag
% matters because empheq and amsmath's trial passes can drop a primary label
% without writing it; a stale queue then never matches a later line.
\gdef\mermin@queue{}
\gdef\mermin@tag{}
% Set when \alsolabel had to occupy \df@label because no \label came yet.
\gdef\mermin@promoted{}
\newif\ifmermin@also

% Go through whatever \label means here, so amsmath's trial passes (which
% gobble or defer \label) treat \alsolabel exactly as they treat \label.
% cleveref's multline trial pass skips \label@in@display and calls amsmath's
% original directly, as \cref@old@label@in@display{<stored form>}.
\newcommand\alsolabel[1]{%
  \begingroup
    \mermin@alsotrue
    \ifdefined\mermin@cref@old
      \let\cref@old@label@in@display\mermin@also@stored
    \fi
    \label{#1}%
  \endgroup}

% Call the saved \label@in@display with cleveref's inner hook restored.
\def\mermin@call@orig#1{%
  \begingroup
    \ifdefined\mermin@cref@old
      \let\cref@old@label@in@display\mermin@cref@old
    \fi
    \mermin@orig@label@in@display#1%
  \endgroup}

% \mermin@form := the form \label@in@display would store for key #1.
\def\mermin@canonical#1{%
  \global\let\mermin@saved\df@label
  \global\let\df@label\@empty
  \mermin@call@orig{{#1}}%
  \global\let\mermin@form\df@label
  \global\let\df@label\mermin@saved
}

% Queue \mermin@form for the current \df@label, skipping duplicates (a
% display typeset twice runs \alsolabel twice).
\def\mermin@enqueue{%
  \ifx\mermin@tag\df@label\else
    \gdef\mermin@queue{}%
    \global\let\mermin@tag\df@label
  \fi
  \begingroup
    \let\mermin@found\@empty
    \def\do##1{\def\mermin@tmp{##1}%
      \ifx\mermin@tmp\mermin@form \def\mermin@found{x}\fi}%
    \mermin@queue
    \ifx\mermin@found\@empty
      \toks@\@xp{\mermin@form}%
      \xdef\mermin@queue{\unexpanded\@xp{\mermin@queue}\noexpand\do{\the\toks@}}%
    \fi
  \endgroup
}

\def\mermin@also@in@display#1{%
  \mermin@canonical{#1}%
  \@xp\mermin@also@stored\@xp{\mermin@form}%
}

% #1 is a key already in stored form.
\def\mermin@also@stored#1{%
  \ifx\df@label\@empty
    \gdef\df@label{#1}%
    \global\let\mermin@promoted\df@label
    \global\let\mermin@tag\df@label
    \gdef\mermin@queue{}%
  \else
    \gdef\mermin@form{#1}%
    \mermin@enqueue
  \fi
}

\def\mermin@real@in@display#1{%
  \ifx\mermin@promoted\@empty
    \mermin@call@orig{#1}%
  \else\ifx\mermin@promoted\df@label
    % A real \label after \alsolabel: the real one becomes primary and the
    % promoted key joins the extras.
    \global\let\mermin@form\df@label
    \ifx\mermin@tag\df@label\else\gdef\mermin@queue{}\fi
    \global\let\df@label\@empty
    \mermin@call@orig{#1}%
    \global\let\mermin@tag\df@label
    \mermin@enqueue
    \gdef\mermin@promoted{}%
  \else
    \gdef\mermin@promoted{}%
    \mermin@call@orig{#1}%
  \fi\fi
}

% Hook in after every package's \AtBeginDocument code, where hyperref and
% cleveref install their own \ltx@label and \label@in@display, so load order
% does not matter.
\AddToHook{begindocument/end}{%
  \let\mermin@ltx@label\ltx@label
  \def\ltx@label#1{%
    \mermin@ltx@label{#1}%
    \def\mermin@tmp{#1}%
    \ifx\mermin@tmp\mermin@tag
      \begingroup
        \let\do\mermin@ltx@label
        \mermin@queue
      \endgroup
      \gdef\mermin@queue{}\gdef\mermin@tag{}\gdef\mermin@promoted{}%
    \fi}%
  \let\mermin@orig@label@in@display\label@in@display
  \ifdefined\cref@old@label@in@display
    \let\mermin@cref@old\cref@old@label@in@display
  \fi
  \def\label@in@display{%
    \ifmermin@also
      \expandafter\mermin@also@in@display
    \else
      \expandafter\mermin@label@in@display
    \fi}%
}
% Pass cleveref's optional argument through untouched.
\def\mermin@label@in@display{%
  \@ifnextchar[\mermin@label@in@display@opt\mermin@label@in@display@noarg}
\def\mermin@label@in@display@opt[#1]#2{\mermin@real@in@display{[#1]{#2}}}
\def\mermin@label@in@display@noarg#1{\mermin@real@in@display{{#1}}}

\endinput
