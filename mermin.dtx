% \maketitle
%
% \begin{abstract}
% The \textsf{mermin} package helps physicists write equations the way
% N.~David Mermin asks in ``What's Wrong with These Equations?''\
% \cite{mermin}.
% An equation is labeled by the noun phrases that describe it, as many as
% the prose needs, with \cs{aka}, and cited by one of those phrases
% with \cs{eq}, which prints the phrase and the number together.
% Citing an equation by a bare number becomes the harder thing to write.
% \end{abstract}
%
% \section{Introduction}
%
% In his 1989 column~\cite{mermin} Mermin proposed three rules for
% equations in physics writing.
% Fisher's rule asks that every displayed equation be numbered, whether or
% not the text refers to it yet, because readers, referees, and later papers
% will.
% The Good Samaritan rule asks that an equation be cited by a phrase as well
% as a number, so that the reader need not page back to learn what
% ``(11)'' says: one writes ``the anomaly condition~(11)'', never a bare
% ``(11)'' and never ``Eq.~(11) shows''.
% An equation number locates; the noun phrase says what is there.
% The third rule, that mathematics is prose, asks that a display be
% punctuated as part of its sentence, so that the paragraph reads straight
% through the equation.
%
% \LaTeX\ makes the Good Samaritan rule harder than it need be.
% A label is an arbitrary key, so nothing ties a citation to the phrase
% that should accompany it, and \textsf{amsmath} allows a numbered line
% exactly one \cs{label}, although the right phrase depends on why the
% equation is being cited.
% The same line may be ``the anomaly condition'' in one paragraph and
% ``the Pythagorean condition'' in another.
% This package makes the phrase the key.
% A line is labeled by each phrase that describes it, and \cs{eq} cites it
% by one of them, printing the phrase and the number.
%
% \section{Usage}
%
% \DescribeMacro{\aka}
% \DescribeMacro{\eq}
% Load the package with |\usepackage{mermin}|.
% Then |\aka{|\meta{phrase}|}|, for ``also known as'', attaches
% \meta{phrase} as a key to the
% current equation, or to the current line of a multi-line display, in
% addition to its \cs{label}.
% It may be used any number of times on a line, before or after the
% \cs{label}, or on a line that has no \cs{label} at all.
% Every key refers to the same number and, with \textsf{hyperref}, to the
% same anchor.
% |\eq{|\meta{phrase}|}| prints \meta{phrase}, a tie, and the equation
% number in parentheses, linked by \textsf{hyperref} to the equation.
%
% Consider two-flavor chiral gauge theories whose gauge anomaly cancels
% when the left- and right-handed charges obey
% \begin{equation}
%   L_1^2+L_2^2=R_1^2+R_2^2.
%   \label{anomaly condition}
%   \aka{Pythagorean condition}
% \end{equation}
% The source of this display, and of a paragraph that cites it, reads
% \begin{verbatim}
% \begin{equation}
%   L_1^2+L_2^2=R_1^2+R_2^2.
%   \label{anomaly condition}
%   \aka{Pythagorean condition}
% \end{equation}
%
% The 3450 model, with charges $(3,4\,\vert\,5,0)$, satisfies
% the \eq{anomaly condition}.
% Read as a statement about integers, the same line is
% the \eq{Pythagorean condition}, and $3^2+4^2=5^2$ is its
% smallest nontrivial solution.
% \end{verbatim}
% and typesets as
% \begin{quote}
% The 3450 model, with charges $(3,4\,\vert\,5,0)$, satisfies
% the \eq{anomaly condition}.
% Read as a statement about integers, the same line is
% the \eq{Pythagorean condition}, and $3^2+4^2=5^2$ is its
% smallest nontrivial solution.
% \end{quote}
% We advise leaving the article out of the phrase and in the prose.
% Capitalization is the reason.
% A sentence that opens with a citation needs ``The'', one that cites in
% the middle needs ``the'', and |The \eq{anomaly condition}| handles both,
% because the capital falls on the article, which the sentence supplies.
% With the article inside the key, the capitalized and lowercase forms
% would be different labels.
% Keeping it out also leaves the sentence free to say ``this'', ``that'',
% or nothing at all.
% This is only advice: a label such as |the anomaly condition| works like
% any other key.
%
% Lines of an \textsf{align} are labeled the same way, one set of phrases
% per line, and a line may be labeled by \cs{aka} alone:
% \begin{verbatim}
% \begin{align}
%   S &= \int d^2x\,\mathcal{L} \label{action} \aka{fermion action} \\
%   P_{L,R} &= \tfrac12(1\pm\gamma_5) \aka{chiral projectors}
% \end{align}
% \end{verbatim}
%
% Labels written with an |eq:| prefix, as many papers already have, need
% no change: when no label \meta{phrase} exists, \cs{eq} uses
% |eq:|\meta{phrase}.
% For example, |\eq{shift relation}| cites the line labeled
% |\label{eq:shift relation}|.
% \cs{eq} prints its argument as the phrase, so a key that is not
% printable text, such as |E_field|, also needs a phrase.
% Without one \cs{eq} prints the key verbatim and, once the label exists,
% warns.
% To give a phrase to a line that already has a \cs{label}, add \cs{aka}
% with the same key, |\label{E_field}\aka[$E$ field]{E_field}|, or replace
% the \cs{label} with it.
% A phrase with mathematics is dropped from PDF bookmarks, as mathematics
% is from any bookmark; \textsf{hyperref}'s \cs{texorpdfstring} gives a
% plain-text form, as in |\aka[\texorpdfstring{$E$}{E} field]{E_field}|.
% A phrase that cannot be a key, because it contains mathematics or a
% command, is given where the label is defined, as the optional argument of
% \cs{aka}, and every citation then uses the plain key.
% For example, a compact boson on a lattice may be given the Villain action
% \begin{equation}
%   S_\Gamma=\frac{\beta}{2}\sum_{\ell}\left(d\phi-2\pi n\right)_\ell^2.
%   \aka[$\Gamma$ action]{Gamma action}
%   \aka{Villain model}
% \end{equation}
% The source of this display, and of a paragraph that cites it by both
% phrases, reads
% \begin{verbatim}
% \begin{equation}
%   S_\Gamma=\frac{\beta}{2}\sum_{\ell}\left(d\phi-2\pi n\right)_\ell^2.
%   \aka[$\Gamma$ action]{Gamma action}
%   \aka{Villain model}
% \end{equation}
%
% The integer field $n$ makes the \eq{Gamma action} invariant
% under $\phi\to\phi+2\pi k$ with $n\to n+dk$.
% Summed over $n$, the \eq{Villain model} is a periodic function
% of each $d\phi_\ell$.
% \end{verbatim}
% and typesets as
% \begin{quote}
% The integer field $n$ makes the \eq{Gamma action} invariant
% under $\phi\to\phi+2\pi k$ with $n\to n+dk$.
% Summed over $n$, the \eq{Villain model} is a periodic function
% of each $d\phi_\ell$.
% \end{quote}
%
% Because \cs{label} is left alone, two \cs{label}s on one line remain the
% error \textsf{amsmath} has always reported; only \cs{aka} adds
% keys.
% Citing a key with \cs{ref}, \cs{eqref}, \cs{pageref}, or the
% \textsf{cleveref} command \cs{cref} works exactly as for a key given to
% \cs{label}.
% Outside a display \cs{aka} is simply \cs{label}, so it can also
% give a section, a figure, or a theorem a second name.
% In \textsf{beamer}, |\aka<|\meta{overlay}|>| passes the overlay to
% \cs{label}, as |\label<|\meta{overlay}|>| does; in a display, where
% \textsf{amsmath}'s \cs{label} takes no overlay, the overlay is dropped.
% Like \cs{label}, \cs{aka} on a line without a number, such as one with
% \cs{notag} or in |equation*|, labels the next numbered line, or the
% current section; put it on a numbered line.
% \cs{eq} is for equations only, since it prints a parenthesized number,
% and it warns when its key names anything else.
% In a heading that a class sets in capitals, the phrase is left as
% written, since it is printed from its key; give such a heading a short
% form for the running head, as in |\section[|\ldots|]{|\ldots|}|.
%
% \DescribeMacro{\alsolabel}
% \DescribeMacro{\eqcite}
% Short names are easily taken.
% \cs{alsolabel} and \cs{eqcite} are the same commands as \cs{aka} and
% \cs{eq}, under names no other package uses.
% Several packages, among them \textsf{nccmath}, define their own \cs{eq},
% and a document may define its own \cs{aka}.
% \textsf{mermin} then leaves the existing command alone, says so in a
% warning, and the document uses the long name instead.
%
% \section{Compatibility}
%
% The package works in the \textsf{amsmath} environments \textsf{equation},
% \textsf{align}, \textsf{gather}, \textsf{multline}, \textsf{split} (with
% the keys given in the enclosing \textsf{equation}), and
% \textsf{subequations}, and in \textsf{empheq}.
% It works with \textsf{hyperref} and \textsf{cleveref} loaded either
% before or after it; it loads \textsf{amsmath} itself, which
% \textsf{cleveref} still requires to be loaded before it.
% It requires a \LaTeX\ format from 2021-11-15 or later, for the
% hooks it uses.
% arXiv compiles papers with its own fixed \TeX\ Live installations, which
% do not receive new packages, so a paper submitted there should include
% \texttt{mermin.sty} among its files.
% With the \textsf{mathtools} option |showonlyrefs|, a line is numbered
% when any of its keys is cited.
% \textsf{breqn}'s |dmath| and |dseries|, the \textsf{cases} package's
% |numcases| and |subnumcases|, \textsf{IEEEtrantools}' |IEEEeqnarray|,
% and the kernel's \textsf{eqnarray} are supported.
% So are \textsf{xr} and \textsf{xr-hyper}: |\eq{S-|\meta{key}|}| cites an
% equation of a document loaded with |\externaldocument[S-]|, and prints
% its phrase, or its key without the prefix; the |eq:| fallback reaches
% it too, so |\eq{S-sum rule}| cites |\label{eq:sum rule}| there.
% \textsf{autonum} is not supported: it copies \cs{label} before this
% package can attach its extra keys, and numbers a line by its first key only.
% \cs{aka}, like \cs{label}, vanishes from tables of contents, running
% heads, and PDF bookmarks; in a bookmark \cs{eq} gives its phrase and
% number as plain text.
%
% The package's repository,
% \url{https://github.com/evanberkowitz/mermin}, also holds a test suite
% and the issue tracker.
% Running |make test| there typesets every environment above, with the
% keys given before, after, and instead of \cs{label}, in four package configurations, and checks that
% each key in the resulting \texttt{.aux} file carries its line's number
% and anchor.
% It also checks the text \cs{eq} prints, that \cs{eq} warns exactly when
% it cites something other than an equation, and that \cs{alsolabel} and
% \cs{eqcite} take over when \cs{aka} and \cs{eq} are taken.
% The suite runs with pdf\LaTeX, Lua\LaTeX, and Xe\LaTeX\ on the current
% \TeX\ Live, and with pdf\LaTeX\ on \TeX\ Live 2021, 2023, and 2025.
%
% \begin{thebibliography}{1}
% \bibitem{mermin}
%   N.~D. Mermin, ``What's Wrong with These Equations?'',
%   \emph{Physics Today} \textbf{42}(10), 9 (1989),
%   \href{https://doi.org/10.1063/1.2811173}{doi:10.1063/1.2811173}.
% \end{thebibliography}
%
% \StopEventually{}
%
% \section{Implementation}
%
% \textsf{amsmath} does not write a display label when it meets \cs{label}.
% It stores the key in |\df@label| and writes it with
% |\ltx@label{|\meta{contents of \texttt{\char`\\df@label}}|}| once the
% line's tag, and so |\@currentlabel| and the \textsf{hyperref} anchor, are
% known.
% The package keeps the extra keys of a line in a queue and writes them
% immediately after that primary label, so they receive the same number and
% anchor.
%
% Three complications shape the code.
% First, \textsf{cleveref} stores keys in a different form, wrapping the key
% in braces or preceding it with an optional argument, so every queued key
% is stored in exactly the form |\label@in@display| would have stored it.
% Second, \textsf{amsmath} and \textsf{empheq} typeset some displays twice,
% once to measure them, and may discard a primary label without writing it.
% The queue is therefore tagged with the primary label it belongs to and
% written only when that label is, and a key is never queued twice.
% Third, \cs{alsolabel} may come before \cs{label} or without it.
% It then occupies |\df@label| itself, and a later \cs{label} reclaims the
% slot and moves the earlier key into the queue.
%
% Two further records travel through the \texttt{.aux} file, like labels
% themselves, so that a citation may precede its equation: the typeset
% phrases given to \cs{alsolabel}, and the keys that belong to equations,
% which \cs{eqcite} consults before warning.
%
%    \begin{macrocode}
%<*package>
\RequirePackage{amsmath}
%    \end{macrocode}
%
% \begin{macro}{\mermin@queue}
% \begin{macro}{\mermin@tag}
% \begin{macro}{\mermin@promoted}
% The queue holds extra keys as |\do{|\meta{stored form}|}|.
% The tag is the |\df@label| the queue belongs to.
% |\mermin@promoted| is nonempty when \cs{alsolabel} occupies |\df@label|
% because no \cs{label} has come yet.
%    \begin{macrocode}
\gdef\mermin@queue{}
\gdef\mermin@tag{}
\gdef\mermin@promoted{}
\newif\ifmermin@also
%    \end{macrocode}
% \end{macro}
% \end{macro}
% \end{macro}
%
% \begin{macro}{\alsolabel}
% Where \LaTeX\ disables \cs{label}, as it does in the text written to a
% table of contents or a running head, \cs{alsolabel} disappears with it,
% together with its arguments.
% Releases before 2025-06-01 make \cs{label} |\@gobble| or |\relax|
% there; later ones make it |\@gobble@om|, or
% |\@gobble@with@sphack@om| where it is typeset, and \cs{alsolabel} then
% uses that command itself.
% It is therefore expandable, and only chooses between that and the real
% command, |\mermin@alsolabel|, which is robust.
% The real command calls whatever \cs{label} means at that point, with a
% flag raised.
% The measuring passes of \textsf{amsmath} gobble or defer \cs{label}, and
% \cs{alsolabel} thereby inherits the same treatment.
% In a display \cs{label} is |\label@in@display|, which the package wraps
% below to read the flag.
% \textsf{cleveref}'s measuring pass for \textsf{multline} skips
% |\label@in@display| and calls \textsf{amsmath}'s original, saved as
% |\cref@old@label@in@display|, directly with the stored form of the key;
% that hook is redirected as well.
% The optional typeset phrase is recorded first, by
% |\mermin@writephrase| below.
% The group would keep \cs{label}'s |\@esphack| from removing the space
% after it in running text, so the whole command is wrapped in its own
% |\@bsphack| and |\@esphack|.
%    \begin{macrocode}
\def\alsolabel{%
  \ifx\label\@gobble \mermin@aka@use\mermin@gobble@aka\fi
  \ifx\label\relax \mermin@aka@use\mermin@gobble@aka\fi
  \ifx\label\@gobble@om \mermin@aka@use\mermin@gobble@aka\fi
  \ifx\label\@gobble@with@sphack@om
    \mermin@aka@use\@gobble@with@sphack@om\fi
  \mermin@alsolabel}
\def\mermin@aka@use#1#2\mermin@alsolabel{\fi#1}
\NewExpandableDocumentCommand\mermin@gobble@aka{d<> o m}{}
\NewDocumentCommand\mermin@alsolabel{d<> o m}{%
  \@bsphack
  \IfValueT{#2}{\mermin@writephrase{#3}{#2}}%
  \begingroup
    \mermin@alsotrue
    \ifdefined\mermin@cref@old
      \let\cref@old@label@in@display\mermin@also@stored
    \fi
    \IfValueTF{#1}%
      {\ifx\label\label@in@display\label{#3}\else\label<#1>{#3}\fi}%
      {\label{#3}}%
  \endgroup
  \@esphack}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\mermin@writephrase}
% \begin{macro}{\mermin@newphrase}
% A typeset phrase travels through the \texttt{.aux} file, like the label
% itself, so that \cs{eq} can print it before or after the definition.
% When \LaTeX\ rereads the \texttt{.aux} file at the end of the document to
% look for changed labels, a changed phrase also asks for another run.
% |\mermin@newphrase{|\meta{key}|}{|\meta{phrase}|}| defines
% |\mermin@ph@|\meta{key}.
% The phrase does not depend on the page, so it is written immediately;
% a display typeset twice writes it twice, which is harmless.
% The key is expanded as \cs{label} expands it, so that a key such as
% |sec\thesection:mass| is recorded as the same key in both places.
% The keys that had phrases when the run began are remembered; after the
% reread, any key whose phrase is gone also asks for another run.
% A key read through \textsf{xr} defines its phrase directly, so it is
% not checked.
% Phrases are compared by their characters only: \textsf{unicode-math}
% changes the category of letters such as $\Gamma$ after the \texttt{.aux} file
% is first read, and a comparison of tokens would ask for a rerun forever.
% A |\providecommand| at the top of the \texttt{.aux} file lets a document
% that stops loading the package read its old \texttt{.aux} without error.
%    \begin{macrocode}
\def\mermin@writephrase#1#2{%
  \if@filesw
    \begingroup
      \let\protect\@unexpandable@protect
      \immediate\write\@auxout{%
        \string\mermin@newphrase{#1}{\unexpanded{#2}}}%
    \endgroup
  \fi}
\def\mermin@newphrase#1#2{%
  \global\let\mermin@marked\@empty
  \ifx\@newl@bel\@testdef
    \global\@namedef{mermin@seen@#1}{}%
    \edef\reserved@a{\detokenize{#2}}%
    \edef\reserved@b{\detokenize\@xp\@xp\@xp
      {\csname mermin@ph@#1\endcsname}}%
    \ifx\reserved@a\reserved@b\else\@tempswatrue\fi
  \else
    \expandafter\gdef\csname mermin@ph@#1\endcsname{#2}%
    \g@addto@macro\mermin@phkeys{\do{#1}}%
  \fi}
\let\mermin@phkeys\@empty
\def\mermin@checkphrases{%
  \def\do##1{\@ifundefined{mermin@seen@##1}{\@tempswatrue}{}}%
  \mermin@phkeys}
\AddToHook{enddocument/afteraux}{\if@filesw\mermin@checkphrases\fi}
\AtBeginDocument{%
  \if@filesw
    \immediate\write\@auxout{%
      \string\providecommand\string\mermin@newphrase[2]{}}%
  \fi}
%    \end{macrocode}
% \end{macro}
% \end{macro}
%
% \begin{macro}{\mermin@markeq}
% \begin{macro}{\mermin@equation}
% \cs{eq} warns when it cites a label that is not an equation, so every
% equation key is recorded, again through the \texttt{.aux} file:
% |\mermin@equation{|\meta{key}|}| defines |\mermin@eq@|\meta{key}.
%    \begin{macrocode}
\def\mermin@markeq#1{%
  \if@filesw
    \begingroup
      \let\protect\@unexpandable@protect
      \immediate\write\@auxout{\string\mermin@equation{#1}}%
    \endgroup
  \fi}
\def\mermin@equation#1{%
  \global\let\mermin@marked\@empty
  \expandafter\gdef\csname mermin@eq@#1\endcsname{}}
\AtBeginDocument{%
  \if@filesw
    \immediate\write\@auxout{%
      \string\providecommand\string\mermin@equation[1]{}}%
  \fi}
\AddToHook{include/before}{%
  \if@filesw
    \immediate\write\@partaux{%
      \string\providecommand\string\mermin@newphrase[2]{}%
      \string\providecommand\string\mermin@equation[1]{}}%
  \fi}
%    \end{macrocode}
% \end{macro}
% \end{macro}
%
% \begin{macro}{\mermin@xr@test}
% \textsf{xr} and \textsf{xr-hyper} import another document's labels, as
% for a paper and its supplement, by reading that document's \texttt{.aux}
% file a line at a time with |\XR@test|, which keeps only \cs{newlabel} and
% \cs{bibcite} lines.
% The wrapper also imports the records of equation keys and phrases, with
% the external document's prefix added to each key.
% It is installed once, whether \textsf{xr} is loaded before or after this
% package.
%    \begin{macrocode}
\long\def\mermin@xr@test#1#2#3#4\XR@{%
  \ifdefined\eq\else\let\eq\eqcite\fi
  \ifdefined\aka\else\let\aka\alsolabel\fi
  \ifx#1\mermin@equation
    \mermin@equation{\XR@prefix#2}%
    \def\mermin@xr@key{#2}%
    \mermin@xr@eqsplit\relax#2\mermin@stop eq:\mermin@stop\mermin@nil
    \@ifundefined{mermin@ph@\XR@prefix#2}%
      {\@xp\xdef\csname mermin@ph@\XR@prefix#2\endcsname
         {\unexpanded\@xp{\mermin@xr@rest}}}{}%
  \else\ifx#1\mermin@newphrase
    \@xp\gdef\csname mermin@ph@\XR@prefix#2\endcsname{#3}%
  \fi\fi
  \mermin@xr@orig#1{#2}{#3}#4\XR@}
\def\mermin@xr@eqsplit#1eq:#2\mermin@stop#3\mermin@nil{%
  \def\mermin@tmp{#1}%
  \ifx\mermin@tmp\mermin@relax
    \def\mermin@xr@rest{#2}%
    \@xp\xdef\csname mermin@xreq@\XR@prefix#2\endcsname
      {\XR@prefix\unexpanded{eq:#2}}%
  \else
    \@xp\def\@xp\mermin@xr@rest\@xp{\mermin@xr@key}%
  \fi}
\def\mermin@relax{\relax}
\def\mermin@xr@patch{%
  \ifdefined\mermin@xr@orig\else
    \let\mermin@xr@orig\XR@test
    \let\XR@test\mermin@xr@test
  \fi}
\AddToHook{package/xr/after}{\mermin@xr@patch}
\AddToHook{package/xr-hyper/after}{\mermin@xr@patch}
\@ifpackageloaded{xr}{\mermin@xr@patch}{}
\@ifpackageloaded{xr-hyper}{\mermin@xr@patch}{}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\mermin@markargs}
% Keys are recorded as equations where an \textsf{amsmath} display
% registers them, in |\label@in@display|, and not where labels are
% written: |\ltx@label|, which writes them, can also be reached from
% outside a display.
% A key arrives as |{|\meta{key}|}|, as |[|\meta{type}|]{|\meta{key}|}| with
% \textsf{cleveref}'s optional argument, or, without \textsf{cleveref}, as
% \textsf{amsmath} stores it, the bare \meta{key}.
% |\mermin@markargs| records the key in any of these forms.
%    \begin{macrocode}
\def\mermin@markargs#1{%
  \iffalse{\fi
  \mermin@keyof#1\mermin@nil
  \@xp\mermin@markeq\@xp{\mermin@rawkey}%
  \iffalse}\fi}
\def\mermin@keyof{%
  \@ifnextchar[\mermin@keyof@opt\mermin@keyof@plain}
\def\mermin@keyof@plain#1\mermin@nil{\def\mermin@rawkey{#1}}
\def\mermin@keyof@opt[#1]#2\mermin@nil{\def\mermin@rawkey{#2}}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\mermin@marklabels}
% The label of a \textsf{subequations} group, numbered like ``(12)'', is
% an ordinary \cs{label} between the displays, and the displays of
% \textsf{breqn}, |dmath| and |dseries|, use the ordinary \cs{label} too,
% as do \textsf{eqnarray}, |numcases|, |subnumcases|, and |IEEEeqnarray|.
% Inside these environments \cs{label} therefore also records its key.
% The \textsf{amsmath} displays within them install their own \cs{label},
% and an environment nested in another, such as |dmath| in |dgroup| or in
% \textsf{subequations}, finds \cs{label} already wrapped and leaves it.
%    \begin{macrocode}
\def\mermin@marklabels{%
  \ifx\label\mermin@marklabel\else
    \let\mermin@sub@orig\label
    \let\label\mermin@marklabel
  \fi}
\def\mermin@marklabel{\@ifnextchar[\mermin@sub@opt\mermin@sub@noarg}
\AddToHook{env/subequations/begin}{\mermin@marklabels}
\AddToHook{env/dmath/begin}{\mermin@marklabels}
\AddToHook{env/dseries/begin}{\mermin@marklabels}
\AddToHook{env/eqnarray/begin}{\mermin@marklabels}
\AddToHook{env/numcases/begin}{\mermin@marklabels}
\AddToHook{env/subnumcases/begin}{\mermin@marklabels}
\AddToHook{env/IEEEeqnarray/begin}{\mermin@marklabels}
\AddToHook{env/IEEEeqnarray*/begin}{\mermin@marklabels}
\def\mermin@sub@noarg#1{\mermin@markeq{#1}\mermin@sub@orig{#1}}
\def\mermin@sub@opt[#1]#2{\mermin@markeq{#2}\mermin@sub@orig[#1]{#2}}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\mermin@call@orig}
% This calls the |\label@in@display| that was in force before the package
% wrapped it, with \textsf{cleveref}'s inner hook restored, and records the
% key as an equation.
% The argument is the complete argument list, braces included.
%    \begin{macrocode}
\def\mermin@call@orig#1{%
  \mermin@markargs{#1}%
  \begingroup
    \ifdefined\mermin@cref@old
      \let\cref@old@label@in@display\mermin@cref@old
    \fi
    \mermin@orig@label@in@display#1%
  \endgroup}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\mermin@canonical}
% This sets |\mermin@form| to the form in which |\label@in@display| would
% store the key |#1|, by letting it store the key into an emptied
% |\df@label| and restoring the old contents afterwards.
%    \begin{macrocode}
\def\mermin@canonical#1{%
  \global\let\mermin@saved\df@label
  \global\let\df@label\@empty
  \mermin@call@orig{{#1}}%
  \global\let\mermin@form\df@label
  \global\let\df@label\mermin@saved
}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\mermin@enqueue}
% This queues |\mermin@form| for the current |\df@label|.
% A queue tagged with a different label is stale and is discarded first.
% A form already in the queue is skipped, because a display typeset twice
% runs its \cs{alsolabel}s twice.
% With the \textsf{mathtools} option |showonlyrefs| a line is numbered only
% if its primary label was cited, which \textsf{mathtools} records as
% |\MT_r_|\meta{label}; a citation of a queued key counts for the line too.
%    \begin{macrocode}
\def\mermin@enqueue{%
  \ifx\mermin@tag\df@label\else
    \gdef\mermin@queue{}%
    \global\let\mermin@tag\df@label
  \fi
  \iffalse{\fi
  \@xp\mermin@keyof\mermin@form\mermin@nil
  \@ifundefined{MT_r_\mermin@rawkey}{}%
    {\global\@namedef{MT_r_\df@label}{}}%
  \iffalse}\fi
  \begingroup
    \let\mermin@found\@empty
    \def\do##1{\def\mermin@tmp{##1}%
      \ifx\mermin@tmp\mermin@form \def\mermin@found{x}\fi}%
    \mermin@queue
    \ifx\mermin@found\@empty
      \toks@\@xp{\mermin@form}%
      \xdef\mermin@queue{%
        \unexpanded\@xp{\mermin@queue}\noexpand\do{\the\toks@}}%
    \fi
  \endgroup
}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\mermin@also@in@display}
% \begin{macro}{\mermin@also@stored}
% \cs{alsolabel} in a display converts its key to stored form.
% If the line has no label yet, the key becomes the primary label and is
% marked as promoted; otherwise it is queued.
%    \begin{macrocode}
\def\mermin@also@in@display#1{%
  \mermin@canonical{#1}%
  \@xp\mermin@also@stored\@xp{\mermin@form}%
}
\def\mermin@also@stored#1{%
  \mermin@markargs{#1}%
  \def\mermin@tmp{#1}%
  \ifx\mermin@tmp\df@label
    % The line's label already has this key: nothing to add.
  \else\ifx\df@label\@empty
    \gdef\df@label{#1}%
    \global\let\mermin@promoted\df@label
    \global\let\mermin@tag\df@label
    \gdef\mermin@queue{}%
  \else
    \gdef\mermin@form{#1}%
    \mermin@enqueue
  \fi\fi
}
%    \end{macrocode}
% \end{macro}
% \end{macro}
%
% \begin{macro}{\mermin@real@in@display}
% A real \cs{label} normally passes straight through, and so still reports
% a second \cs{label} on one line as an error.
% If instead the line's primary label was promoted from \cs{alsolabel}, the
% real key takes the slot and the promoted key joins the queue.
% A promotion left over from a discarded measuring pass no longer matches
% |\df@label| and is cleared.
%    \begin{macrocode}
\def\mermin@real@in@display#1{%
  \ifx\mermin@promoted\@empty
    \mermin@call@orig{#1}%
  \else\ifx\mermin@promoted\df@label
    \global\let\mermin@form\df@label
    \ifx\mermin@tag\df@label\else\gdef\mermin@queue{}\fi
    \global\let\df@label\@empty
    \mermin@call@orig{#1}%
    \global\let\mermin@tag\df@label
    \ifx\mermin@form\df@label\else\mermin@enqueue\fi
    \gdef\mermin@promoted{}%
  \else
    \gdef\mermin@promoted{}%
    \mermin@call@orig{#1}%
  \fi\fi
}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\mermin@cref@entry}
% \textsf{cleveref}'s \textsf{multline} trial pass hands its inner hook the
% key braced, |{|\meta{key}|}|, with \textsf{amsmath} before 2025, but bare
% with \textsf{amsmath}~2.17z.
% This accepts either, or |[|\meta{type}|]{|\meta{key}|}|, and passes the
% key on as \cs{label} would.
% It tells the forms apart by the first character of the detokenized
% argument, so that a bare key is never scanned as a delimited argument:
% inside an alignment an |&| in it would end the cell.
%    \begin{macrocode}
\def\mermin@firstof#1{\@xp\mermin@firstof@\detokenize{#1}\mermin@nil}
\def\mermin@firstof@#1#2\mermin@nil{#1}
\def\mermin@cref@entry#1{%
  \if\mermin@firstof{#1}[\@xp\@firstoftwo\else\@xp\@secondoftwo\fi
    {\mermin@cref@entry@opt#1\mermin@nil}%
    {\if\mermin@firstof{#1}\@charlb\@xp\@firstoftwo\else\@xp\@secondoftwo\fi
       {\mermin@real@in@display{#1}}%
       {\mermin@real@in@display{{#1}}}}}
\def\mermin@cref@entry@opt[#1]#2\mermin@nil{%
  \mermin@real@in@display{[#1]{#2}}}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\mermin@label@in@display}
% A real \cs{label} in a display arrives here, with \textsf{cleveref}'s
% optional argument passed through untouched.
%    \begin{macrocode}
\def\mermin@label@in@display{%
  \@ifnextchar[\mermin@label@in@display@opt\mermin@label@in@display@noarg}
\def\mermin@label@in@display@opt[#1]#2{\mermin@real@in@display{[#1]{#2}}}
\def\mermin@label@in@display@noarg#1{\mermin@real@in@display{{#1}}}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\ltx@label}
% \begin{macro}{\label@in@display}
% \textsf{hyperref} and \textsf{cleveref} install their own |\ltx@label|
% and |\label@in@display| in |\AtBeginDocument| code.
% The package wraps them in the |begindocument/end| hook, which runs after
% all such code, so that load order does not matter.
% The new |\ltx@label| writes the primary label as before and then, if
% the queue belongs to it, every queued key.
% The new |\label@in@display| sends \cs{alsolabel} and \cs{label} their
% separate ways.
%    \begin{macrocode}
\AddToHook{begindocument/end}{%
  \let\mermin@ltx@label\ltx@label
  \def\ltx@label#1{%
    \mermin@ltx@label{#1}%
    \def\mermin@tmp{#1}%
    \ifx\mermin@tmp\mermin@tag
      \begingroup
        \let\do\mermin@ltx@label
        \mermin@queue
      \endgroup
      \gdef\mermin@queue{}\gdef\mermin@tag{}\gdef\mermin@promoted{}%
    \fi}%
  \let\mermin@orig@label@in@display\label@in@display
  \ifdefined\cref@old@label@in@display
    \let\mermin@cref@old\cref@old@label@in@display
    % cleveref's multline trial pass calls this directly; give it the same
    % treatment as \label, which \mermin@call@orig undoes locally.
    \def\cref@old@label@in@display#1{\mermin@cref@entry{#1}}%
  \fi
  \def\label@in@display{%
    \ifmermin@also
      \expandafter\mermin@also@in@display
    \else
      \expandafter\mermin@label@in@display
    \fi}%
}
%    \end{macrocode}
% \end{macro}
% \end{macro}
%
% \begin{macro}{\eqcite}
% \cs{eqcite} resolves its argument to a key: the argument itself, unless only
% |eq:|\meta{phrase} is defined, in which case that key is used.
% Before the first run defines any label, the key is the argument itself,
% so the usual undefined-reference warning names it, and the argument is
% printed verbatim: it may be a key such as |E_field| whose phrase is not
% yet known, and would stop the run if typeset.
% It warns if the key is defined but was not recorded as an equation.
% It then prints the typeset phrase recorded for that key, or the argument
% if none was recorded, a tie, and the equation number from \cs{eqref},
% which \textsf{hyperref} makes a link.
% In math mode the whole citation is set as text, with \cs{text}.
%    \begin{macrocode}
\NewDocumentCommand\eqcite{m}{%
  \mermin@eq@key{#1}%
  \@ifundefined{r@\mermin@key}{}{%
    \ifdefined\mermin@marked
      \@ifundefined{mermin@eq@\mermin@key}{%
        \PackageWarning{mermin}{`#1' is not an equation label,\MessageBreak
          yet \string\eq\space prints a parenthesized equation
          number;\MessageBreak use \string\ref\space or \string\cref\space
          for figures, sections, and theorems}}{}%
    \fi}%
  \ifmmode\@xp\text\else\@xp\@firstofone\fi
  {\@ifundefined{mermin@ph@\mermin@key}%
     {\@ifundefined{r@\mermin@key}%
        {\mermin@verbatim{#1}}%
        {\mermin@ifunprintable{#1}%
           {\PackageWarning{mermin}{`#1' has no typeset phrase and is not
              text,\MessageBreak so it is printed verbatim; give the line
              \MessageBreak\string\aka[\mermin@phrasemeta]{\mermin@key}\space
              beside its\MessageBreak\string\label{\mermin@key}}%
            \mermin@verbatim{#1}}%
           {#1}}}%
     {\csname mermin@ph@\mermin@key\endcsname}%
   ~\@xp\eqref\@xp{\mermin@key}}%
}
\def\mermin@phrasemeta{<phrase>}
\def\mermin@verbatim#1{{\normalfont\ttfamily\detokenize{#1}}}
\edef\mermin@specials{\detokenize{_^$&}\@percentchar\@backslashchar}
\def\mermin@ifunprintable#1{%
  \edef\mermin@tmp{\detokenize{#1}}%
  \let\mermin@bad\@empty
  \@xp\@tfor\@xp\mermin@c\@xp:\@xp=\mermin@specials\do{%
    \edef\reserved@a{\noexpand\in@{\mermin@c}{\mermin@tmp}}\reserved@a
    \ifin@\def\mermin@bad{x}\fi}%
  \ifx\mermin@bad\@empty\@xp\@secondoftwo\else\@xp\@firstoftwo\fi}
\def\mermin@eq@key#1{%
  \def\mermin@key{#1}%
  \@ifundefined{r@#1}{%
    \@ifundefined{r@eq:#1}%
      {\@ifundefined{mermin@xreq@#1}{}%
         {\edef\mermin@key{\csname mermin@xreq@#1\endcsname}}}%
      {\def\mermin@key{eq:#1}}%
  }{}%
}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\eq}
% \begin{macro}{\aka}
% The short names \cs{eq} and \cs{aka} may already be taken, \cs{eq} for
% instance by \textsf{nccmath}.
% Each is therefore assigned only at |begindocument/end|, after every
% package and the preamble have had the chance to define it, and only if it
% is still free.
% Otherwise the existing command is kept and the user is told to write the
% long name.
% Each short name is a copy of the long one made with \cs{let}, so it
% keeps the long one's behaviour in moving arguments.
% For \textsf{hyperref}'s bookmarks \cs{aka} and \cs{alsolabel} vanish,
% and \cs{eq} and \cs{eqcite} expand to the phrase and \cs{ref} of the
% number.
% In text that \cs{MakeUppercase} changes, such as running heads, the
% argument of \cs{eq} is kept as written, since it is a key.
%    \begin{macrocode}
\def\mermin@shortname#1#2{%
  \@ifundefined{#1}%
    {\@xp\let\csname #1\endcsname#2}%
    {\PackageWarningNoLine{mermin}{\@backslashchar#1 was already defined,
      by a package or\MessageBreak the preamble, and is left alone; write
      \string#2\space instead}}}
\AddToHook{begindocument/end}{%
  \mermin@shortname{eq}\eqcite
  \mermin@shortname{aka}\alsolabel
  \ifdefined\pdfstringdefDisableCommands
    \pdfstringdefDisableCommands{%
      \let\alsolabel\mermin@gobble@aka
      \let\eqcite\mermin@pdf@eq
      \ifx\aka\mermin@alsolabel@short\let\aka\mermin@gobble@aka\fi
      \ifx\eq\mermin@eqcite@short\let\eq\mermin@pdf@eq\fi}%
  \fi
  \@ifundefined{l_text_case_exclude_arg_tl}{}{%
    \@xp\g@addto@macro\csname l_text_case_exclude_arg_tl\endcsname
      {\eqcite\mermin@alsolabel}%
    \ifx\eq\mermin@eqcite@short
      \@xp\g@addto@macro\csname l_text_case_exclude_arg_tl\endcsname
        {\eq}%
    \fi}%
}
\let\mermin@alsolabel@short\alsolabel
\let\mermin@eqcite@short\eqcite
\def\mermin@pdf@eq#1{%
  \ifcsname r@#1\endcsname\@xp\@firstoftwo\else\@xp\@secondoftwo\fi
    {\mermin@pdf@cite{#1}{#1}}%
    {\ifcsname r@eq:#1\endcsname\@xp\@firstoftwo\else\@xp\@secondoftwo\fi
       {\mermin@pdf@cite{#1}{eq:#1}}%
       {\ifcsname mermin@xreq@#1\endcsname
          \@xp\@firstoftwo\else\@xp\@secondoftwo\fi
          {\mermin@pdf@cite{#1}{\csname mermin@xreq@#1\endcsname}}%
          {\mermin@pdf@cite{#1}{#1}}}}}
\def\mermin@pdf@cite#1#2{%
  \ifcsname mermin@ph@#2\endcsname\@xp\@firstoftwo\else\@xp\@secondoftwo\fi
    {\csname mermin@ph@#2\endcsname}{#1}%
  \space(\ref{#2})}
%</package>
%    \end{macrocode}
% \end{macro}
% \end{macro}
%
% \Finale
\endinput
