% \section{Implementation}
%
% The implementation has ten parts.
% Parts~\ref{impl:load}--\ref{impl:aux} set up the package and the records
% it keeps in the \texttt{.aux} file.
% Parts~\ref{impl:aka}--\ref{impl:queue} define \cs{alsolabel} and the
% machinery that gives a display line several keys.
% Part~\ref{impl:xr} imports the records of another document through
% \textsf{xr}.
% Parts~\ref{impl:cite}--\ref{impl:short} define \cs{eqcite} and the
% short names, and make both behave in headings and bookmarks.
%
% The narrative is here; the code carries short comments only where a
% construction looks odd or exists for one particular package, so that a
% reader of the bare \texttt{mermin.sty} is not lost.
%
% \subsection{Loading}\label{impl:load}
%
% The package needs \textsf{amsmath}, whose display machinery it extends.
% IOP's \textsf{iopart} class defines |equation*| itself, which
% \textsf{amsmath} then refuses to redefine; IOP's documented remedy is to
% undefine it first, and the package does so when \textsf{iopart} is the
% class and \textsf{amsmath} is not yet loaded.
%    \begin{macrocode}
%<*package>
 % iopart.cls defines equation*, and amsmath would stop with "Command
 % \equation* already defined"; this is IOP's own workaround.  amsmath's
 % \@xp is not defined yet, hence \expandafter.
\@ifclassloaded{iopart}{%
  \@ifpackageloaded{amsmath}{}{%
    \expandafter\let\csname equation*\endcsname\relax
    \expandafter\let\csname endequation*\endcsname\relax}}{}
\RequirePackage{amsmath}
%    \end{macrocode}
%
% \subsection{Utilities}\label{impl:util}
%
% \begin{macro}{\mermin@firstof}
% \begin{macro}{\mermin@ifeqprefix}
% Two expandable tests on a key look at its characters rather than its
% tokens.
% |\mermin@firstof{|\meta{text}|}| expands to the first character of
% \meta{text}, as a character of category 12.
% |\mermin@ifeqprefix{|\meta{key}|}{|\meta{true}|}{|\meta{false}|}| tests
% whether \meta{key} begins with |eq:|.
% Both detokenize first, for two reasons.
% A key is never scanned as a delimited argument, which inside an
% alignment would end the cell at an |&| in the key; and the test does not
% depend on categories, which \textsf{babel} languages change: French makes
% the colon active in the document body.
% |\if| compares character codes only, so the category-12 characters of
% the detokenized key match the letters typed here.
%    \begin{macrocode}
\def\mermin@firstof#1{%
  \@xp\mermin@firstof@\detokenize{#1}\relax\mermin@nil}
 % The \relax keeps an empty key from leaving #1 empty.
\def\mermin@firstof@#1#2\mermin@nil{#1}
\def\mermin@ifeqprefix#1{%
  \@xp\mermin@ifeqprefix@\detokenize{#1}\relax\relax\relax\mermin@nil}
\def\mermin@ifeqprefix@#1#2#3#4\mermin@nil{%
  \ifnum\if e#1\if q#2\if :#3 1\else 0\fi\else 0\fi\else 0\fi=1
    \@xp\@firstoftwo
  \else
    \@xp\@secondoftwo
  \fi}
%    \end{macrocode}
% \end{macro}
% \end{macro}
%
% \begin{macro}{\mermin@ifunprintable}
% \begin{macro}{\mermin@verbatim}
% A key that is printed as text, because it has no typeset phrase, must
% not contain characters that typesetting would misread.
% |\mermin@ifunprintable| tests for them; |\mermin@verbatim| prints a key
% character by character in typewriter type, whose fonts have every
% \textsc{ascii} character.
% Braces are not in the list: \cs{in@} cannot find a brace character, and
% a key with braces prints, only without them.
%    \begin{macrocode}
\edef\mermin@specials{\detokenize{_^$&<>|}\@percentchar\@backslashchar}
\def\mermin@ifunprintable#1{%
  \edef\mermin@tmp{\detokenize{#1}}%
  \let\mermin@bad\@empty
  \@xp\@tfor\@xp\mermin@c\@xp:\@xp=\mermin@specials\do{%
    \edef\reserved@a{\noexpand\in@{\mermin@c}{\mermin@tmp}}\reserved@a
    \ifin@\def\mermin@bad{x}\fi}%
  \ifx\mermin@bad\@empty\@xp\@secondoftwo\else\@xp\@firstoftwo\fi}
\def\mermin@verbatim#1{{\normalfont\ttfamily\detokenize{#1}}}
%    \end{macrocode}
% \end{macro}
% \end{macro}
%
% \subsection{Records in the \texttt{.aux} file}\label{impl:aux}
%
% Three kinds of record travel through the \texttt{.aux} file, like
% labels, so that a citation may come before its equation:
% \begin{itemize}
% \item the typeset phrase given to \cs{alsolabel}, as |\mermin@newphrase|
%   with the arguments \meta{key} and \meta{phrase}, which defines
%   |\mermin@ph@|\meta{key};
% \item |\mermin@equation{|\meta{key}|}|, which records that \meta{key}
%   labels an equation, by defining |\mermin@eq@|\meta{key}, so that
%   \cs{eqcite} can warn about anything else;
% \item |\mermin@auxmark|, once per file, which says that the file was
%   written with this package.
% \end{itemize}
% Until a file with the mark has been read, \cs{eqcite} does not warn about
% non-equations: a paper that has just adopted the package has an
% \texttt{.aux} file full of equation labels and no records of them.
%
% \begin{macro}{\mermin@record}
% Records do not depend on the page, so they are written immediately.
% The argument is expanded as \cs{label} expands its key, robust commands
% excepted, so that a key such as |sec\thesection:mass| is recorded as the
% same key that \cs{label} writes.
%    \begin{macrocode}
\def\mermin@record#1{%
  \if@filesw
    \begingroup
      \let\protect\@unexpandable@protect
      \immediate\write\@auxout{#1}%
    \endgroup
  \fi}
\def\mermin@writephrase#1#2{%
  \mermin@record{\string\mermin@newphrase{#1}{\unexpanded{#2}}}}
\def\mermin@markeq#1{\mermin@record{\string\mermin@equation{#1}}}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\mermin@auxheader}
% Each \texttt{.aux} file starts with |\providecommand|s for the three
% records, so that a document that stops loading the package still reads
% its old files, and with the mark.
% Files of chapters read with \cs{include} get the same header: under
% \cs{includeonly} their old files are read without being rewritten.
% The mark is on a line of its own, where \textsf{xr}, which looks only at
% the first token of a line, can see it.
%    \begin{macrocode}
\def\mermin@auxheader#1{%
  \immediate\write#1{%
    \string\providecommand\string\mermin@newphrase[2]{}%
    \string\providecommand\string\mermin@equation[1]{}%
    \string\providecommand\string\mermin@auxmark{}}%
  \immediate\write#1{\string\mermin@auxmark}}
\AtBeginDocument{\if@filesw\mermin@auxheader\@auxout\fi}
\AddToHook{include/before}{\if@filesw\mermin@auxheader\@partaux\fi}
\def\mermin@auxmark{\global\let\mermin@marked\@empty}
\def\mermin@equation#1{%
  \global\let\mermin@marked\@empty
  \@xp\gdef\csname mermin@eq@#1\endcsname{}}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\mermin@newphrase}
% \begin{macro}{\mermin@checkphrases}
% When \LaTeX\ rereads the \texttt{.aux} file at the end of the document
% to look for changed labels, a changed phrase also asks for another run.
% So does a removed one: the keys that had phrases when the run began are
% listed in |\mermin@phkeys|, and after the reread any of them that was
% not seen again sets the same flag.
% Phrases are compared by their characters only.
%    \begin{macrocode}
\let\mermin@phkeys\@empty
\def\mermin@newphrase#1#2{%
  \global\let\mermin@marked\@empty
   % The end-of-document reread is recognized by \@setckpt, which the
   % kernel (and REVTeX) makes \@gobbletwo only then.  \@newl@bel is the
   % obvious test, but acronym changes it during the reread.
  \ifx\@setckpt\@gobbletwo
    \global\@namedef{mermin@seen@#1}{}%
     % Detokenized: unicode-math changes the category of letters such as
     % a literal Gamma after the .aux file is first read, and comparing
     % tokens would ask for a rerun forever.
    \edef\reserved@a{\detokenize{#2}}%
    \edef\reserved@b{%
      \detokenize\@xp\@xp\@xp{\csname mermin@ph@#1\endcsname}}%
    \ifx\reserved@a\reserved@b\else\@tempswatrue\fi
  \else
    \@xp\gdef\csname mermin@ph@#1\endcsname{#2}%
    \g@addto@macro\mermin@phkeys{\do{#1}}%
  \fi}
\def\mermin@checkphrases{%
  \def\do##1{\@ifundefined{mermin@seen@##1}{\@tempswatrue}{}}%
  \mermin@phkeys}
 % afteraux runs after the reread and before the kernel's rerun warning.
\AddToHook{enddocument/afteraux}{\if@filesw\mermin@checkphrases\fi}
%    \end{macrocode}
% \end{macro}
% \end{macro}
%
% \subsection{The command \cs{alsolabel}}\label{impl:aka}
%
% \begin{macro}{\alsolabel}
% Where \LaTeX\ disables \cs{label}, as it does in the text written to a
% table of contents or a running head, \cs{alsolabel} must disappear with
% it, together with its arguments.
% \cs{alsolabel} is therefore expandable: it looks at what \cs{label}
% means and expands either to a gobbler or to the real command,
% |\mermin@alsolabel|, which is robust.
% Releases before 2025-06-01 disable \cs{label} as |\@gobble| or
% |\relax|; later ones as |\@gobble@om|, or |\@gobble@with@sphack@om|
% where the text is typeset, which \cs{alsolabel} then uses itself.
%
% \cs{alsolabel} also disappears in text that \textsf{latexdiff} marks as
% deleted.
% \textsf{latexdiff} keeps a deleted display, as |displaymath| between
% |\DIFdelbegin| and |\DIFdelend|, and comments out the \cs{label}s in
% it, but its list of label commands is fixed and cannot be extended; a
% deleted \cs{alsolabel} would define its key a second time, possibly with
% the wrong number.
% The package therefore raises a flag, |\mermin@indel|, between the two
% markers.
%    \begin{macrocode}
\let\mermin@indel\relax
\AddToHook{begindocument/end}{%
  \ifdefined\DIFdelbegin % latexdiff output
    \let\mermin@DIFdelbegin\DIFdelbegin
    \let\mermin@DIFdelend\DIFdelend
    \protected\def\DIFdelbegin{%
      \global\let\mermin@indel\@empty\mermin@DIFdelbegin}%
    \protected\def\DIFdelend{%
      \mermin@DIFdelend\global\let\mermin@indel\relax}%
  \fi}
\def\alsolabel{%
  \ifx\mermin@indel\@empty \mermin@aka@use\mermin@gobble@aka\fi
  \ifx\label\@gobble \mermin@aka@use\mermin@gobble@aka\fi
  \ifx\label\relax \mermin@aka@use\mermin@gobble@aka\fi
  \ifx\label\@gobble@om \mermin@aka@use\mermin@gobble@aka\fi
  \ifx\label\@gobble@with@sphack@om
    \mermin@aka@use\@gobble@with@sphack@om\fi
  \mermin@alsolabel}
 % \mermin@aka@use ends the test that matched, drops the remaining tests up
 % to \mermin@alsolabel, and leaves #1 in its place.
\def\mermin@aka@use#1#2\mermin@alsolabel{\fi#1}
\NewExpandableDocumentCommand\mermin@gobble@aka{d<> o m}{}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\mermin@alsolabel}
% The real command records the optional phrase and then calls whatever
% \cs{label} means at that point, with the flag |\ifmermin@also| raised.
% In a display \cs{label} is |\label@in@display|, which
% part~\ref{impl:queue} wraps to read the flag; elsewhere \cs{label} acts as
% usual, and \cs{alsolabel} gives a section or a figure a second name.
% The measuring passes of \textsf{amsmath} gobble or defer \cs{label}, and
% \cs{alsolabel} inherits the same treatment.
% A \textsf{beamer} overlay, |<|\meta{overlay}|>|, goes to \textsf{beamer}'s
% \cs{label} outside displays, and is dropped inside them.
%    \begin{macrocode}
\newif\ifmermin@also
\NewDocumentCommand\mermin@alsolabel{d<> o m}{%
   % \label ends with \@esphack, but inside the group below it cannot
   % remove the space after the command in running text; the command
   % therefore has its own \@bsphack and \@esphack.
  \@bsphack
  \IfValueT{#2}{\mermin@writephrase{#3}{#2}}%
  \begingroup
    \mermin@alsotrue
     % cleveref's multline trial pass calls this hook directly instead of
     % \label@in@display; see \mermin@cref@entry.
    \ifdefined\mermin@cref@old
      \let\cref@old@label@in@display\mermin@also@stored
    \fi
    \IfValueTF{#1}%
       % Only beamer's \label takes an overlay: the document's \label, or
       % \mermin@marklabel wrapping it.  amsmath's display \label does not.
      {\ifx\label\mermin@doclabel
         \label<#1>{#3}%
       \else\ifx\label\mermin@marklabel
         \label<#1>{#3}%
       \else
         \label{#3}%
       \fi\fi}%
      {\label{#3}}%
  \endgroup
  \@esphack}
%    \end{macrocode}
% \end{macro}
%
% \subsection{Which keys are equations}\label{impl:mark}
%
% \begin{macro}{\mermin@markargs}
% \begin{macro}{\mermin@keyof}
% A key is recorded as an equation where a display registers it, and not
% where labels are written: |\ltx@label|, which writes them, is reached
% from outside displays too.
% A key arrives as |{|\meta{key}|}|, as |[|\meta{type}|]{|\meta{key}|}|
% with \textsf{cleveref}'s optional argument, or as \textsf{amsmath} stores
% it without \textsf{cleveref}, the bare \meta{key}.
% |\mermin@keyof| sets |\mermin@rawkey| to the key in any of these forms.
%    \begin{macrocode}
\def\mermin@markargs#1{%
   % The \iffalse braces raise TeX's alignment brace count without opening
   % a group, so that an & in a bare key, scanned as a delimited argument
   % inside align, does not end the cell.
  \iffalse{\fi
  \mermin@keyof#1\mermin@nil
  \@xp\mermin@markeq\@xp{\mermin@rawkey}%
  \iffalse}\fi}
\def\mermin@keyof{\@ifnextchar[\mermin@keyof@opt\mermin@keyof@plain}
\def\mermin@keyof@plain#1\mermin@nil{\def\mermin@rawkey{#1}}
\def\mermin@keyof@opt[#1]#2\mermin@nil{\def\mermin@rawkey{#2}}
%    \end{macrocode}
% \end{macro}
% \end{macro}
%
% \begin{macro}{\mermin@marklabels}
% Some equations are labeled by an ordinary \cs{label}, not by
% |\label@in@display|: the label of a \textsf{subequations} group, numbered
% like ``(12)'', and the labels in \textsf{breqn}'s displays, in the
% \textsf{cases} package's |numcases|, in \textsf{IEEEtrantools}'
% |IEEEeqnarray|, in \textsf{subeqnarray}, and in the kernel's
% \textsf{eqnarray}.
% Inside these environments \cs{label} also records its key.
% The \textsf{amsmath} displays within them install their own \cs{label},
% and an environment nested in another, such as |dmath| in |dgroup|,
% finds \cs{label} already wrapped and leaves it.
%    \begin{macrocode}
\def\mermin@marklabels{%
  \ifx\label\mermin@marklabel\else
    \let\mermin@sub@orig\label
    \let\label\mermin@marklabel
  \fi}
 % beamer's \label takes an overlay, <...>, before the optional argument.
\def\mermin@marklabel{%
  \@ifnextchar<\mermin@sub@ov{\@ifnextchar[\mermin@sub@opt\mermin@sub@noarg}}
\def\mermin@sub@noarg#1{\mermin@markeq{#1}\mermin@sub@orig{#1}}
\def\mermin@sub@opt[#1]#2{\mermin@markeq{#2}\mermin@sub@orig[#1]{#2}}
\def\mermin@sub@ov<#1>#2{\mermin@markeq{#2}\mermin@sub@orig<#1>{#2}}
\def\mermin@markenv#1{\AddToHook{env/#1/begin}{\mermin@marklabels}}
\@for\mermin@env:=%
    subequations,% amsmath
    dmath,dseries,dgroup,% breqn
    numcases,subnumcases,% cases
    IEEEeqnarray,IEEEeqnarray*,% IEEEtrantools
    eqnarray,% LaTeX kernel
    subeqnarray% subeqnarray
  \do{\@xp\mermin@markenv\@xp{\mermin@env}}
 % subeqnarray labels each row with \slabel, which writes \newlabel itself.
\AddToHook{env/subeqnarray/begin}{%
  \let\mermin@slabel@orig\slabel
  \def\slabel#1{\mermin@markeq{#1}\mermin@slabel@orig{#1}}}
%    \end{macrocode}
% \end{macro}
%
% \subsection{Extra keys on a display line}\label{impl:queue}
%
% \textsf{amsmath} does not write a display label when it meets \cs{label}.
% It stores the key in |\df@label| and writes it with
% |\ltx@label{|\meta{contents of \texttt{\char`\\df@label}}|}| once the
% line's tag, and so |\@currentlabel| and the \textsf{hyperref} anchor, are
% known.
% The package keeps the extra keys of a line in a queue and writes them
% immediately after that primary label, so they receive the same number and
% anchor.
%
% Three complications shape the code.
% First, \textsf{cleveref} stores keys in a different form, wrapping the
% key in braces or preceding it with an optional argument, so every queued
% key is stored in exactly the form |\label@in@display| would have stored
% it.
% Second, \textsf{amsmath} and \textsf{empheq} typeset some displays twice,
% once to measure them, and may discard a primary label without writing
% it.
% The queue is therefore tagged with the primary label it belongs to and
% written only when that label is, and a key is never queued twice.
% Third, \cs{alsolabel} may come before \cs{label} or without it.
% It then occupies |\df@label| itself, \emph{promoted}, and a later
% \cs{label} reclaims the slot and moves the earlier key into the queue.
%
% \begin{macro}{\mermin@queue}
% \begin{macro}{\mermin@tag}
% \begin{macro}{\mermin@promoted}
% The queue holds extra keys as |\do{|\meta{stored form}|}|.
% The tag is the |\df@label| the queue belongs to.
% |\mermin@promoted| is nonempty while \cs{alsolabel} occupies
% |\df@label|.
% All three are global, like |\df@label| itself, because the cells of an
% alignment are groups.
%    \begin{macrocode}
\gdef\mermin@queue{}
\gdef\mermin@tag{}
\gdef\mermin@promoted{}
%    \end{macrocode}
% \end{macro}
% \end{macro}
% \end{macro}
%
% \begin{macro}{\mermin@call@orig}
% \begin{macro}{\mermin@canonical}
% |\mermin@call@orig| calls the |\label@in@display| that was in force
% before the package wrapped it, and records the key as an equation.
% Its argument is the complete argument list, braces included.
% |\mermin@canonical{|\meta{key}|}| sets |\mermin@form| to the form in which
% that |\label@in@display| would store \meta{key}, by letting it store the
% key into an emptied |\df@label| and restoring the old contents.
%    \begin{macrocode}
\def\mermin@call@orig#1{%
  \mermin@markargs{#1}%
  \begingroup
     % Undo, locally, the redirection of cleveref's inner hook.
    \ifdefined\mermin@cref@old
      \let\cref@old@label@in@display\mermin@cref@old
    \fi
    \mermin@orig@label@in@display#1%
  \endgroup}
\def\mermin@canonical#1{%
  \global\let\mermin@saved\df@label
  \global\let\df@label\@empty
  \mermin@call@orig{{#1}}%
  \global\let\mermin@form\df@label
  \global\let\df@label\mermin@saved}
%    \end{macrocode}
% \end{macro}
% \end{macro}
%
% \begin{macro}{\mermin@enqueue}
% This queues |\mermin@form| for the current |\df@label|.
% A queue tagged with a different label is stale and is discarded first.
% A form already in the queue is skipped: a display typeset twice runs its
% \cs{alsolabel}s twice, and \cs{text} typesets its argument four times.
% With the \textsf{mathtools} option |showonlyrefs| a line is numbered only
% if its primary label was cited, which \textsf{mathtools} records as
% |\MT_r_|\meta{label}; a citation of a queued key counts for the line too.
%    \begin{macrocode}
\def\mermin@enqueue{%
  \ifx\mermin@tag\df@label\else
    \gdef\mermin@queue{}%
    \global\let\mermin@tag\df@label
  \fi
  \iffalse{\fi % alignment guard, as in \mermin@markargs
  \@xp\mermin@keyof\mermin@form\mermin@nil
  \@ifundefined{MT_r_\mermin@rawkey}{}%
    {\global\@namedef{MT_r_\df@label}{}}%
  \iffalse}\fi
  \begingroup
    \let\mermin@found\@empty
    \def\do##1{\def\mermin@tmp{##1}%
      \ifx\mermin@tmp\mermin@form \def\mermin@found{x}\fi}%
    \mermin@queue
    \ifx\mermin@found\@empty
      \toks@\@xp{\mermin@form}%
      \xdef\mermin@queue{%
        \unexpanded\@xp{\mermin@queue}\noexpand\do{\the\toks@}}%
    \fi
  \endgroup}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\mermin@also@in@display}
% \begin{macro}{\mermin@also@stored}
% \cs{alsolabel} in a display converts its key to stored form.
% A key the line's label already has adds nothing, so that
% |\label{K}\aka[|\meta{phrase}|]{K}| gives an existing label a phrase.
% If the line has no label yet, the key is promoted; otherwise it is
% queued.
%    \begin{macrocode}
\def\mermin@also@in@display#1{%
  \mermin@canonical{#1}%
  \@xp\mermin@also@stored\@xp{\mermin@form}}
\def\mermin@also@stored#1{%
  \mermin@markargs{#1}%
  \def\mermin@tmp{#1}%
  \ifx\mermin@tmp\df@label
  \else\ifx\df@label\@empty
    \gdef\df@label{#1}%
    \global\let\mermin@promoted\df@label
    \global\let\mermin@tag\df@label
    \gdef\mermin@queue{}%
  \else
    \gdef\mermin@form{#1}%
    \mermin@enqueue
  \fi\fi}
%    \end{macrocode}
% \end{macro}
% \end{macro}
%
% \begin{macro}{\mermin@real@in@display}
% A real \cs{label} normally passes straight through, and so still reports
% a second \cs{label} on one line as an error.
% If instead the line's label was promoted from \cs{alsolabel}, the real
% key takes the slot and the promoted key joins the queue, unless it is
% the same key.
% A promotion left over from a discarded measuring pass no longer matches
% |\df@label| and is cleared.
%    \begin{macrocode}
\def\mermin@real@in@display#1{%
  \ifx\mermin@promoted\@empty
    \mermin@call@orig{#1}%
  \else\ifx\mermin@promoted\df@label
    \global\let\mermin@form\df@label
    \ifx\mermin@tag\df@label\else\gdef\mermin@queue{}\fi
    \global\let\df@label\@empty
    \mermin@call@orig{#1}%
    \global\let\mermin@tag\df@label
    \ifx\mermin@form\df@label\else\mermin@enqueue\fi
    \gdef\mermin@promoted{}%
  \else
    \gdef\mermin@promoted{}%
    \mermin@call@orig{#1}%
  \fi\fi}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\mermin@label@in@display}
% \begin{macro}{\mermin@cref@entry}
% A real \cs{label} in a display arrives at |\mermin@label@in@display|,
% with \textsf{cleveref}'s optional argument passed through.
% \textsf{beamer}'s display \cs{label} takes an overlay, which is dropped.
%
% \textsf{cleveref}'s \textsf{multline} trial pass bypasses
% |\label@in@display| and hands its inner hook,
% |\cref@old@label@in@display|, the stored key: braced, |{|\meta{key}|}|,
% with \textsf{amsmath} before~2.17z, but bare with \textsf{amsmath}~2.17z
% (\TeX\ Live 2025 and later).
% |\mermin@cref@entry| accepts either, or |[|\meta{type}|]{|\meta{key}|}|.
%    \begin{macrocode}
\def\mermin@label@in@display{%
  \@ifnextchar<\mermin@label@in@display@ov
    {\@ifnextchar[\mermin@label@in@display@opt
                 \mermin@label@in@display@noarg}}
\def\mermin@label@in@display@ov<#1>{\mermin@label@in@display}
\def\mermin@label@in@display@opt[#1]#2{\mermin@real@in@display{[#1]{#2}}}
\def\mermin@label@in@display@noarg#1{\mermin@real@in@display{{#1}}}
 % The forms are told apart by first character, never by scanning a bare
 % key, which may hold an & (see \mermin@firstof).  \@charlb is a brace
 % character of category 12.
\def\mermin@cref@entry#1{%
  \if\mermin@firstof{#1}[\@xp\@firstoftwo\else\@xp\@secondoftwo\fi
    {\mermin@cref@entry@opt#1\mermin@nil}%
    {\if\mermin@firstof{#1}\@charlb\@xp\@firstoftwo\else\@xp\@secondoftwo\fi
       {\mermin@real@in@display{#1}}%
       {\mermin@real@in@display{{#1}}}}}
\def\mermin@cref@entry@opt[#1]#2\mermin@nil{%
  \mermin@real@in@display{[#1]{#2}}}
%    \end{macrocode}
% \end{macro}
% \end{macro}
%
% \begin{macro}{\ltx@label}
% \begin{macro}{\label@in@display}
% \textsf{hyperref} and \textsf{cleveref} install their own |\ltx@label|
% and |\label@in@display| in |\AtBeginDocument| code.
% The package wraps them in the |begindocument/end| hook, which runs after
% all such code, so that load order does not matter.
% The new |\ltx@label| writes the primary label as before and then, if the
% queue belongs to it, every queued key except the primary one, which an
% |\aka{A}\aka{K}\label{K}| line would otherwise write twice.
% The new |\label@in@display| sends \cs{alsolabel} and \cs{label} their
% separate ways.
%    \begin{macrocode}
\AddToHook{begindocument/end}{%
  \let\mermin@ltx@label\ltx@label
  \def\ltx@label#1{%
    \mermin@ltx@label{#1}%
    \def\mermin@tmp{#1}%
    \ifx\mermin@tmp\mermin@tag
      \begingroup
        \def\do##1{\def\mermin@tmp{##1}%
          \ifx\mermin@tmp\mermin@tag\else\mermin@ltx@label{##1}\fi}%
        \mermin@queue
      \endgroup
      \gdef\mermin@queue{}\gdef\mermin@tag{}\gdef\mermin@promoted{}%
    \fi}%
  \let\mermin@orig@label@in@display\label@in@display
  \ifdefined\cref@old@label@in@display
    \let\mermin@cref@old\cref@old@label@in@display
    \def\cref@old@label@in@display#1{\mermin@cref@entry{#1}}%
  \fi
  \def\label@in@display{%
    \ifmermin@also
      \expandafter\mermin@also@in@display
    \else
      \expandafter\mermin@label@in@display
    \fi}%
  \let\mermin@doclabel\label}
%    \end{macrocode}
% \end{macro}
% \end{macro}
%
% \subsection{Documents read through \textsf{xr}}\label{impl:xr}
%
% \textsf{xr} and \textsf{xr-hyper} import another document's labels, as
% for a paper and its supplement, by reading that document's \texttt{.aux}
% file a line at a time with |\XR@test|, which keeps only \cs{newlabel}
% and \cs{bibcite} lines.
% A wrapper also imports the records, with the external document's prefix
% added to each key.
% For every equation key it imports, it stores the text that \cs{eqcite}
% prints when the key has no phrase, the key without the prefix (and
% without |eq:|), in |\mermin@xrdef@|\meta{prefixed key}; and for a key
% |eq:|\meta{rest} it defines the |eq:| fallback
% |\mermin@xreq@|\meta{prefix}\meta{rest}, which \cs{eqcite}'s resolver
% calls.
% A document that does not use the package records no equations; its file
% has no mark, and all its labels are imported as equations rather than
% warned about.
% The wrapper is installed once, whether \textsf{xr} is loaded before or
% after this package; an \cs{externaldocument} called before the package
% is loaded is beyond its reach.
%    \begin{macrocode}
\long\def\mermin@xr@test#1#2#3#4\XR@{%
   % \eq and \aka in titles stored in the other file are expanded here, in
   % the preamble, before the short names exist.
  \ifdefined\eq\else\let\eq\eqcite\fi
  \ifdefined\aka\else\let\aka\alsolabel\fi
  \ifx#1\mermin@auxmark
    \def\mermin@xr@marked{}%
  \else\ifx#1\mermin@equation
    \mermin@xr@import{#2}%
  \else\ifx#1\mermin@newphrase
    \@xp\gdef\csname mermin@ph@\XR@prefix#2\endcsname{#3}%
  \else\ifx#1\newlabel
    \ifdefined\mermin@xr@marked\else\mermin@xr@import{#2}\fi
  \fi\fi\fi\fi
  \mermin@xr@orig#1{#2}{#3}#4\XR@}
\def\mermin@xr@import#1{%
  \@xp\gdef\csname mermin@eq@\XR@prefix#1\endcsname{}%
  \mermin@ifeqprefix{#1}%
    {\@xp\mermin@xr@eqkey\@xp{\@gobblethree#1}}%
    {\@xp\xdef\csname mermin@xrdef@\XR@prefix#1\endcsname
       {\unexpanded{#1}}}}
 % For a key eq:<rest>: the text is <rest>, and \mermin@xreq@<prefix><rest>
 % takes the resolver's continuation and passes it <prefix>eq:<rest>.
\def\mermin@xr@eqkey#1{%
  \@xp\xdef\csname mermin@xrdef@\XR@prefix eq:#1\endcsname{\unexpanded{#1}}%
  \@xp\xdef\csname mermin@xreq@\XR@prefix#1\endcsname##1{%
    ##1{\XR@prefix\unexpanded{eq:#1}}}}
\def\mermin@xr@patch{%
  \ifdefined\mermin@xr@orig\else
    \let\mermin@xr@orig\XR@test
    \let\XR@test\mermin@xr@test
  \fi}
\AddToHook{package/xr/after}{\mermin@xr@patch}
\AddToHook{package/xr-hyper/after}{\mermin@xr@patch}
\@ifpackageloaded{xr}{\mermin@xr@patch}{}
\@ifpackageloaded{xr-hyper}{\mermin@xr@patch}{}
%    \end{macrocode}
%
% \subsection{Citing with \cs{eqcite}}\label{impl:cite}
%
% \begin{macro}{\mermin@resolve}
% |\mermin@resolve{|\meta{argument}|}{|\meta{continuation}|}| finds the key
% \meta{argument} cites: the argument itself if it is a label, else
% |eq:|\meta{argument}, else the |eq:| key of another document that
% \textsf{xr} imported, else the argument, which is then undefined.
% It expands to \meta{continuation}|{|\meta{key}|}|.
% It is expandable, so that the same code serves bookmarks, and passes the
% key as an argument rather than storing it, so that nothing depends on a
% macro that a group might end: \textsf{ulem} typesets each word in a group
% of its own.
% |\@ifundefined| treats a label made |\relax| by an earlier failed
% \cs{ref} as undefined.
%    \begin{macrocode}
\def\mermin@resolve#1#2{%
  \@ifundefined{r@#1}%
    {\@ifundefined{r@eq:#1}%
       {\@ifundefined{mermin@xreq@#1}%
          {#2{#1}}%
          {\csname mermin@xreq@#1\endcsname{#2}}}%
       {#2{eq:#1}}}%
    {#2{#1}}}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\mermin@keytext}
% When a key has no typeset phrase, \cs{eqcite} prints the key itself as
% the phrase: for a key imported through \textsf{xr}, without the prefix,
% and otherwise without a leading |eq:|.
% |\mermin@keytext{|\meta{argument}|}{|\meta{key}|}| expands to that text.
%    \begin{macrocode}
\def\mermin@keytext#1#2{%
  \@ifundefined{mermin@xrdef@#2}%
    {\mermin@ifeqprefix{#1}{\@gobblethree#1}{#1}}%
    {\csname mermin@xrdef@#2\endcsname}}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\eqcite}
% \begin{macro}{\mermin@cite}
% \cs{eqcite} resolves its argument.
% |\mermin@cite| receives the argument and the key; it warns if the key is a label but not an equation,
% or if the argument and |eq:|\meta{argument} are both labels of different
% equations (as when a revision adds |\aka{mass}| to one equation while an
% older |\eq{mass}| meant |\label{eq:mass}| on another),
% and prints the phrase, a tie, and the number from \cs{eqref}, which
% \textsf{hyperref} makes a link.
% In math mode the whole citation is set as text.
%    \begin{macrocode}
\NewDocumentCommand\eqcite{m}{\mermin@resolve{#1}{\mermin@cite{#1}}}
\def\mermin@cite#1#2{%
  \mermin@check@ambiguous{#1}%
  \@ifundefined{r@#2}{}{%
    \ifdefined\mermin@marked
      \@ifundefined{mermin@eq@#2}%
        {\PackageWarning{mermin}{`#1' is not an equation label,\MessageBreak
           yet \mermin@eqcs\space prints a parenthesized equation
           number;\MessageBreak use \string\ref\space or \string\cref\space
           for figures, sections, and theorems}}%
        {}%
    \fi}%
  \ifmmode\@xp\text\else\@xp\@firstofone\fi
    {\mermin@phrase{#1}{#2}~\eqref{#2}}}
%    \end{macrocode}
% \end{macro}
% \end{macro}
%
% \begin{macro}{\mermin@phrase}
% The phrase is the typeset phrase recorded for the key, or else the
% key's text, printed verbatim if it is not printable text.
% Once the label exists, a verbatim key also warns, saying where to give
% it a phrase; before the first run defines it, every key is quietly
% verbatim if need be, because its phrase may simply not be known yet.
%    \begin{macrocode}
\def\mermin@check@ambiguous#1{%
  \@ifundefined{r@#1}{}{\@ifundefined{r@eq:#1}{}{%
    \@xp\ifx\csname r@#1\@xp\endcsname\csname r@eq:#1\endcsname
    \else
      \PackageWarning{mermin}{`#1' and `eq:#1' label different
        equations;\MessageBreak \mermin@eqcs{#1} cites `#1'}%
    \fi}}}
\def\mermin@phrase#1#2{%
  \@ifundefined{mermin@ph@#2}%
    {\protected@edef\mermin@text{\mermin@keytext{#1}{#2}}%
     \@xp\mermin@ifunprintable\@xp{\mermin@text}%
       {\@ifundefined{r@#2}{}{\mermin@warn@unprintable{#1}{#2}}%
        \@xp\mermin@verbatim\@xp{\mermin@text}}%
       {\mermin@text}}%
    {\csname mermin@ph@#2\endcsname}}
\def\mermin@warn@unprintable#1#2{%
  \@ifundefined{mermin@xrdef@#2}%
    {\PackageWarning{mermin}{`#1' has no typeset phrase and is not
       text,\MessageBreak so it is printed verbatim; where it is
       defined, write\MessageBreak \mermin@akacs[<phrase>]{#2}}}%
    {\PackageWarning{mermin}{`#1' has no typeset phrase and is not
       text,\MessageBreak so it is printed verbatim; give it a
       phrase in the\MessageBreak document that defines
       `\mermin@text'}}}
%    \end{macrocode}
% \end{macro}
%
% \subsection{Headings, bookmarks, and running heads}\label{impl:heads}
%
% \begin{macro}{\mermin@pdf@eq}
% \textsf{hyperref}'s bookmarks need an expandable \cs{eqcite}, which
% gives the phrase or key text and the number as plain text.
% It uses the same resolver.
%    \begin{macrocode}
\def\mermin@pdf@eq#1{\mermin@resolve{#1}{\mermin@pdf@cite{#1}}}
\def\mermin@pdf@cite#1#2{%
  \@ifundefined{mermin@ph@#2}%
    {\mermin@keytext{#1}{#2}}%
    {\csname mermin@ph@#2\endcsname}%
  \space(\ref{#2})}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\mermin@stripaka}
% \textsf{nameref} takes the name of a section or a caption from its
% title, through \textsf{gettitlestring}.
% That package's default method, which does not expand the title, removes
% \cs{label} from it but knows nothing of \cs{alsolabel}, which would stay
% in the name and define its key again wherever the name is typeset.
% The package wraps the method to remove \cs{alsolabel} too, with its
% arguments: spaces around it go with it at the end of the title, but in
% the middle they stay, so that |Chiral \aka{chiral}fermions| keeps its
% space.
% \cs{aka} is removed only when it is this package's.
% (The expanding method needs nothing: \cs{alsolabel} expands to nothing
% there, since that method disables \cs{label}.)
%    \begin{macrocode}
\ExplSyntaxOn
 % One pattern for both lists of names: a run of the commands, with their
 % <overlay>, [phrase], and {key}, at the end of the title, spaces and all;
 % or one of them anywhere else, spaces kept.
\cs_new:Npn \__mermin_aka_pattern:n #1
  {
    \exp_not:n
      {
        \s* (?: \c{(?:#1)} (?: \< .*? \> )? (?: \[ .*? \] )? \cB. .*? \cE.
          \s* )+ \Z
        | \c{(?:#1)} (?: \< .*? \> )? (?: \[ .*? \] )? \cB. .*? \cE.
      }
  }
\exp_args:NNx \regex_const:Nn \c__mermin_aka_regex
  { \__mermin_aka_pattern:n { aka|alsolabel|mermin@alsolabel } }
\exp_args:NNx \regex_const:Nn \c__mermin_long_regex
  { \__mermin_aka_pattern:n { alsolabel|mermin@alsolabel } }
\cs_new_protected:Npn \mermin@stripaka
  {
    \ifx \aka \mermin@alsolabel@short
      \regex_replace_all:NnN \c__mermin_aka_regex { } \GetTitleStringResult
    \else
      \regex_replace_all:NnN \c__mermin_long_regex { } \GetTitleStringResult
    \fi
  }
\ExplSyntaxOff
\AddToHook{begindocument/end}{%
  \ifdefined\GetTitleStringNonExpand
    \let\mermin@gts@orig\GetTitleStringNonExpand
    \def\GetTitleStringNonExpand#1{\mermin@gts@orig{#1}\mermin@stripaka}%
  \fi}
%    \end{macrocode}
% \end{macro}
%
% In text that \cs{MakeUppercase} changes, such as running heads, the
% argument of \cs{eqcite} is a key and must not change; nor may the key of
% |\mermin@alsolabel|.
% The \LaTeX\ kernel from 2022-06 keeps the argument of every command in
% |\l_text_case_exclude_arg_tl| as written.
%    \begin{macrocode}
\AddToHook{begindocument/end}{%
  \@ifundefined{l_text_case_exclude_arg_tl}{}{%
    \@xp\g@addto@macro\csname l_text_case_exclude_arg_tl\endcsname
      {\eqcite\mermin@alsolabel}%
    \ifx\eq\mermin@eqcite@short
      \@xp\g@addto@macro\csname l_text_case_exclude_arg_tl\endcsname{\eq}%
    \fi}}
%    \end{macrocode}
%
% \subsection{The short names}\label{impl:short}
%
% \begin{macro}{\eq}
% \begin{macro}{\aka}
% The short names \cs{eq} and \cs{aka} may already be taken, \cs{eq} for
% instance by \textsf{nccmath}.
% Each is therefore assigned only at |\begin{document}|, after every
% package and the preamble have had the chance to define it, and only if
% it is still free; otherwise the existing command is kept and the user is
% told to write the long name.
% Each short name is a copy of the long one made with \cs{let}, so it
% behaves like it in moving arguments.
% The warnings then name the commands the document can use.
% The bookmark versions of the commands are installed at the same time.
%    \begin{macrocode}
\let\mermin@alsolabel@short\alsolabel
\let\mermin@eqcite@short\eqcite
\def\mermin@akacs{\string\alsolabel}
\def\mermin@eqcs{\string\eqcite}
\def\mermin@shortname#1#2{%
  \@ifundefined{#1}%
    {\@xp\let\csname #1\endcsname#2}%
    {\PackageWarningNoLine{mermin}{\@backslashchar#1 was already defined,
      by a package or\MessageBreak the preamble, and is left alone; write
      \string#2\space instead}}}
 % env/document/begin, not begindocument/before or later: beamer builds
 % the PDF title, which may hold \eq, in this same hook (ordered after
 % this code by the rule below), and its themes typeset section titles in
 % \AtBeginDocument code.
\AddToHook{env/document/begin}[mermin]{%
  \mermin@shortname{eq}\eqcite
  \mermin@shortname{aka}\alsolabel
  \ifx\aka\alsolabel\def\mermin@akacs{\string\aka}\fi
  \ifx\eq\eqcite\def\mermin@eqcs{\string\eq}\fi
  \ifdefined\pdfstringdefDisableCommands
    \pdfstringdefDisableCommands{%
      \let\alsolabel\mermin@gobble@aka
      \let\eqcite\mermin@pdf@eq
      \ifx\aka\mermin@alsolabel@short\let\aka\mermin@gobble@aka\fi
      \ifx\eq\mermin@eqcite@short\let\eq\mermin@pdf@eq\fi}%
  \fi}
\DeclareHookRule{env/document/begin}{mermin}{before}{beamer}
%</package>
%    \end{macrocode}
% \end{macro}
% \end{macro}
%
% \Finale
\endinput
